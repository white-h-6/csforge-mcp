{
  "name": "dsh-csforge-mcp",
  "version": "0.3.2",
  "private": true,
  "description": "Generic CSForge Streamable HTTP MCP integration and Agent skill, plus an optional local tool-bridge adapter",
  "type": "module",
  "main": "./lib/bridge.js",
  "exports": {
    ".": {
      "default": "./lib/bridge.js"
    },
    "./bridge": {
      "default": "./lib/bridge.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/bridge.js",
    "cordis.patch.yml",
    "README.md",
    "docs/**",
    "locale/*.json",
    "skills/**"
  ],
  "scripts": {
    "check": "node --check lib/bridge.js",
    "test": "node test/register.test.mjs && node test/find-extreme-float.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
